# 유니폼 재고관리 백엔드 환경변수 (실제 값은 .env 에 두고 git 에 올리지 않음)

# 회사 배정 전용 DB 접속 (Postgres 연결 문자열) — IT본부 발급
DATABASE_URL=
# 전용 스키마 이름
DB_SCHEMA=

# 관리자 로그인 비밀번호 (로그인 시 사용)
ADMIN_PASSWORD=

# 로그인 토큰 서명 키 (강한 난수). 배포 시 자동 생성되게 하려면 비워둘 수 있음.
JWT_SECRET=

# ── 시공팀 공개 대시보드(/request) ──
# 시공팀 요청 → 슬랙 DM 릴레이용 워크플로 웹훅 URL (슬랙 워크플로 빌더에서 발급)
SLACK_REQUEST_WEBHOOK=
# 공개 대시보드 '가격 확인' 탭 비밀번호 (서버가 검증)
PRICE_PASSWORD=
